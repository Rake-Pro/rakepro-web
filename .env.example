# Copy to .env for local overrides. All values are optional; defaults shown.
RAKEPRO_ADDR=:8080
RAKEPRO_ENV=development          # development | staging | production
RAKEPRO_LOG_LEVEL=info           # trace | debug | info | warn | error
RAKEPRO_READ_TIMEOUT=5s
RAKEPRO_WRITE_TIMEOUT=10s
RAKEPRO_IDLE_TIMEOUT=120s
RAKEPRO_SHUTDOWN_TIMEOUT=15s

# Live stream chip: shown only while rakecast reports the stream online.
# Set RAKEPRO_STREAM_STATUS_URL empty to disable polling and hide the chip.
RAKEPRO_STREAM_URL=https://stream.rake.pro
RAKEPRO_STREAM_STATUS_URL=https://stream.rake.pro/api/status
RAKEPRO_STREAM_POLL_INTERVAL=30s
